# Mindbliss Power support AI bridge for Chatwoot.
# Keep the real file as .env.mindbliss-support-agent on the support EC2 only.

PORT=9108
NODE_ENV=production

# Chatwoot webhook signature secret and API token.
# Use a Chatwoot User/admin API token here when importing historical conversations;
# AgentBot tokens cannot list conversations.
CHATWOOT_WEBHOOK_SECRET=CHANGE_ME
CHATWOOT_API_ACCESS_TOKEN=CHANGE_ME
CHATWOOT_BASE_URL=http://rails:3000
CHATWOOT_INTERNAL_FORWARDED_PROTO=https
CHATWOOT_WEBHOOK_TOLERANCE_SECONDS=300
CHATWOOT_WEBHOOK_MAX_BODY_BYTES=262144

# Safer default: write private notes for agents. Set true only after manual QA.
CHATWOOT_AI_PUBLIC_REPLIES=false
CHATWOOT_OPEN_ON_ESCALATE=true
CHATWOOT_PRIORITY_TEAM_MAP=
CHATWOOT_AI_LABEL_PREFIX=mb_ai

# Automatic support routing. Rules are evaluated before default/priority team fallback.
# Keep responsible users as Chatwoot account agents, not superadmins.
SUPPORT_ROUTING_ENABLED=true
SUPPORT_ROUTING_RULES=[]
SUPPORT_ROUTING_DEFAULT_TEAM_ID=
SUPPORT_ROUTING_DEFAULT_ASSIGNEE_EMAIL=
SUPPORT_ROUTING_PRIORITY_TEAM_MAP=
SUPPORT_ROUTING_STICKY_RETURNING_AGENT=true
SUPPORT_ROUTING_PREFER_AVAILABLE_AGENTS=true
SUPPORT_ROUTING_ALLOWED_AGENT_ROLES=agent

MEMORY_IMPORT_TOKEN=CHANGE_ME
MEMORY_IMPORT_ACCOUNT_ID=2
MEMORY_IMPORT_STATUS=all
MEMORY_IMPORT_SUPPORT_ONLY=true
MEMORY_IMPORT_INCLUDE_PRIVATE=false
MEMORY_IMPORT_MAX_PAGES=25
MEMORY_IMPORT_MAX_CONVERSATIONS=500
MEMORY_IMPORT_MAX_MESSAGES_PER_CONVERSATION=300
MEMORY_IMPORT_CHUNK_MAX_CHARS=3000
KNOWLEDGE_COMMANDS_ENABLED=true
KNOWLEDGE_COMMAND_MAX_CHARS=8000
RESOLUTION_MEMORY_ENABLED=true
RESOLUTION_MEMORY_INCLUDE_PRIVATE=false
RESOLUTION_MEMORY_MAX_MESSAGES=150
RESOLUTION_MEMORY_CHUNK_MAX_CHARS=3500

# Support answer provider. Use openrouter for AI agents or mindbliss for the legacy
# Mindbliss support RAG API. The same OPENROUTER_API_KEY can also power memory.
SUPPORT_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_CHAT_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_CHAT_MODEL=upstage/solar-pro4
OPENROUTER_HTTP_REFERER=https://soporte.mindblisspower.com
OPENROUTER_APP_TITLE=Mindbliss Chatwoot Support Agent
OPENROUTER_CHAT_TIMEOUT_MS=90000
OPENROUTER_CHAT_MAX_TOKENS=700
OPENROUTER_CHAT_TEMPERATURE=0.2
OPENROUTER_CHAT_MAX_ANSWER_CHARS=1800

# Legacy Mindbliss support RAG API. On soporteCRM this runs in /opt/ai-memory.
# Required only when SUPPORT_AI_PROVIDER=mindbliss.
VP_SUPPORT_AI_URL=http://mindbrain-vp-support:9096
VP_SUPPORT_AI_TOKEN=CHANGE_ME

# Optional vector memory for Chatwoot conversations.
MEMORY_ENABLED=true
QDRANT_URL=http://mindbrain-qdrant:6333
# Optional for private-network Qdrant. Set a real key if Qdrant auth is enabled.
QDRANT_API_KEY=
QDRANT_MEMORY_COLLECTION=chatwoot_memory
FALKORDB_ENABLED=true
# FalkorDB uses the Redis protocol, but this is not Chatwoot's REDIS_URL.
# Keep Chatwoot Redis on redis:6379 and FalkorDB on mindbrain-falkordb:6379.
FALKORDB_URL=redis://:CHANGE_ME@mindbrain-falkordb:6379
FALKORDB_GRAPH=chatwoot_memory
# Uses OPENROUTER_API_KEY unless OPENROUTER_MEMORY_API_KEY is set separately.
OPENROUTER_MEMORY_API_KEY=
OPENROUTER_EMBEDDING_URL=https://openrouter.ai/api/v1/embeddings
OPENROUTER_EMBEDDING_MODEL=intfloat/multilingual-e5-large
OPENROUTER_EMBEDDING_DIMS=1024
MEMORY_SEARCH_LIMIT=5
MEMORY_STORE_MAX_CHARS=4000
MEMORY_RERANK_ENABLED=true
OPENROUTER_RERANK_URL=https://openrouter.ai/api/v1/rerank
SUPPORT_RERANK_MODEL=cohere/rerank-4-pro
