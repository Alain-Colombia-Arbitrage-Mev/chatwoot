# Mindbliss Power voice AI bridge for Chatwoot support.
# Keep the real file as .env.mindbliss-voice-agent on the support EC2 only.

ENV=production
PUBLIC_BASE_URL=https://soporte.mindblisspower.com
VOICE_GATEWAY_PORT=9110
PIPECAT_RUNNER_URL=http://mindbliss-voice-pipecat:9111
VOICE_TWILIO_WS_PUBLIC_URL=wss://soporte.mindblisspower.com/voice/twilio/ws
VOICE_REQUIRE_RUNNER_WS_TOKEN=true

# Public webhook protection. Use a generated random token in production.
VOICE_WEBHOOK_TOKEN=CHANGE_ME
VOICE_ADMIN_TOKEN=CHANGE_ME

# Twilio Programmable Voice / WhatsApp Business Calling through Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_SENDER=

# Meta WhatsApp Cloud API calling. Enable only after WhatsApp Calling is approved.
WHATSAPP_CALLS_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=CHANGE_ME

# Existing Mindbliss support brain and memory network.
VP_SUPPORT_AI_URL=http://mindbrain-vp-support:9096
VP_SUPPORT_AI_TOKEN=CHANGE_ME
QDRANT_URL=http://mindbrain-qdrant:6333
FALKORDB_URL=redis://:CHANGE_ME@mindbrain-falkordb:6379

# Pipecat runner security and AI providers.
PIPECAT_WEBSOCKET_AUTH=token
OPENROUTER_API_KEY=
VOICE_LLM_MODEL=openai/gpt-4o-mini
VOICE_STT_MODEL=openai/whisper-1
VOICE_TTS_MODEL=openai/gpt-4o-mini-tts
VOICE_TTS_VOICE=nova
VOICE_OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
VOICE_LANGUAGE=es

# Optional direct providers. Set provider to deepgram/cartesia to use them.
VOICE_STT_PROVIDER=openai
VOICE_TTS_PROVIDER=openai
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
